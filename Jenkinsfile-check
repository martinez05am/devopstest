pipeline:
  agent:
    any: true
  stages:
  - stage: Checkout
    steps:
    - sh: |
        echo "Checking out repository..."
        git rev-parse --is-inside-work-tree || exit 1
        echo "Repository is present and ready."
  - stage: Verify Clone
    steps:
    - sh: |
        echo "Verifying git clone..."
        if [ -d .git ] && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
          echo "Git repo was cloned successfully."
        else
          echo "ERROR: Git repo clone failed or workspace is not a git repository."
          exit 1
        fi
